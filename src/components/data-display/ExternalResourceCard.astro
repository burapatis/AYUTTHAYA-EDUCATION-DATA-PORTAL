---
import Icon from '../foundation/Icon.astro';

interface Props {
  href: string;
  title: string;
  domain: string;
  description: string;
}

const { href, title, domain, description } = Astro.props;
---

<a class="external-resource" href={href} target="_blank" rel="noopener noreferrer external" aria-label={`${title} — ${domain} (เปิดในแท็บใหม่)`}>
  <span class="external-resource__icon"><Icon name="database" size={21} /></span>
  <span class="external-resource__copy">
    <strong>{title}</strong>
    <span>{description}</span>
    <small>{domain}</small>
  </span>
  <span class="external-resource__arrow" aria-hidden="true"><Icon name="arrow" size={18} /></span>
</a>

<style>
  .external-resource {
    display:grid;
    grid-template-columns:auto minmax(0,1fr) auto;
    align-items:start;
    gap:var(--space-4);
    min-width:0;
    padding:var(--space-5);
    border:1px solid var(--color-border);
    border-radius:var(--radius-lg);
    background:var(--color-white);
    color:inherit;
    text-decoration:none;
    box-shadow:var(--shadow-xs);
    transition:border-color var(--transition-fast),box-shadow var(--transition-fast),transform var(--transition-fast);
  }
  .external-resource:hover { transform:translateY(-2px); border-color:#b9cad8; box-shadow:var(--shadow-sm); }
  .external-resource:focus-visible { outline:3px solid var(--color-blue-100); outline-offset:2px; }
  .external-resource__icon { display:grid; place-items:center; width:2.65rem; height:2.65rem; border-radius:var(--radius-md); background:var(--color-blue-100); color:var(--color-navy-800); }
  .external-resource__copy { display:grid; min-width:0; }
  .external-resource strong { color:var(--color-navy-900); font-size:var(--text-base); }
  .external-resource__copy > span { margin-top:var(--space-1); color:var(--color-slate-600); font-size:var(--text-xs); line-height:1.55; }
  .external-resource small { margin-top:var(--space-3); color:var(--color-blue-700); font-size:.68rem; font-weight:720; letter-spacing:-.01em; overflow-wrap:anywhere; }
  .external-resource__arrow { margin-top:.15rem; color:var(--color-slate-500); transform:rotate(-45deg); transition:transform var(--transition-fast),color var(--transition-fast); }
  .external-resource:hover .external-resource__arrow { color:var(--color-blue-700); transform:translate(2px,-2px) rotate(-45deg); }
</style>
