---
import Icon from '../foundation/Icon.astro';

interface Props {
  title: string;
  description?: string;
  height?: number;
  empty?: boolean;
  emptyLabel?: string;
}

const { title, description, height = 320, empty = false, emptyLabel = 'ยังไม่มีข้อมูลสำหรับมุมมองนี้' } = Astro.props;
---

<section class="chart-panel">
  <header>
    <div>
      <h2>{title}</h2>
      {description && <p>{description}</p>}
    </div>
    <div class="chart-panel__actions"><slot name="actions" /></div>
  </header>
  <div class="chart-panel__canvas" style={`--chart-height: ${height}px`}>
    {empty ? (
      <div class="chart-panel__empty">
        <Icon name="trend" size={30} />
        <span>{emptyLabel}</span>
      </div>
    ) : (
      <slot />
    )}
  </div>
  {Astro.slots.has('footer') && <footer><slot name="footer" /></footer>}
</section>

<style>
  .chart-panel {
    min-width: 0;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-xs);
  }

  header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-4);
  }

  h2 {
    margin: 0;
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
  }

  p {
    margin: var(--space-1) 0 0;
    color: var(--color-slate-600);
    font-size: var(--text-sm);
  }

  .chart-panel__actions {
    flex: 0 0 auto;
  }

  .chart-panel__canvas {
    display: grid;
    min-height: min(var(--chart-height), 52vh);
  }

  .chart-panel__empty {
    display: grid;
    place-content: center;
    justify-items: center;
    min-height: inherit;
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-slate-50);
    color: var(--color-slate-500);
    font-size: var(--text-sm);
  }

  .chart-panel__empty span {
    margin-top: var(--space-2);
  }

  footer {
    padding-top: var(--space-4);
    margin-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    color: var(--color-slate-500);
    font-size: var(--text-xs);
  }
</style>
