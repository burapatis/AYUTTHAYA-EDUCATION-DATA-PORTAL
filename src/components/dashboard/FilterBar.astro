---
interface Option {
  label: string;
  value: string;
}

interface Filter {
  id: string;
  label: string;
  options: Option[];
}

interface Props {
  filters: Filter[];
  resetLabel?: string;
}

const { filters, resetLabel = 'ล้างตัวกรอง' } = Astro.props;
---

<form class="filter-bar" aria-label="ตัวกรองข้อมูล">
  <div class="filter-bar__fields">
    {filters.map((filter) => (
      <label>
        <span>{filter.label}</span>
        <select id={filter.id} name={filter.id}>
          {filter.options.map((option) => <option value={option.value}>{option.label}</option>)}
        </select>
      </label>
    ))}
  </div>
  <button type="reset">{resetLabel}</button>
</form>

<style>
  .filter-bar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    box-shadow: var(--shadow-xs);
  }

  .filter-bar__fields {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  label {
    display: grid;
    min-width: 12rem;
    gap: var(--space-1);
  }

  label span {
    color: var(--color-slate-600);
    font-size: var(--text-xs);
    font-weight: 680;
  }

  select {
    min-height: 2.55rem;
    padding: 0.45rem 2.25rem 0.45rem 0.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background-color: var(--color-white);
    color: var(--color-navy-950);
  }

  button {
    min-height: 2.55rem;
    padding: 0.45rem var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-white);
    color: var(--color-navy-800);
    font-size: var(--text-sm);
    font-weight: 680;
    cursor: pointer;
  }

  button:hover {
    background: var(--color-slate-50);
  }

  @media (max-width: 640px) {
    .filter-bar {
      align-items: stretch;
      flex-direction: column;
    }

    .filter-bar__fields,
    label {
      width: 100%;
    }
  }
</style>
