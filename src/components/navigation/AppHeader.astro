---
import BrandMark from '../brand/BrandMark.astro';
import Icon from '../foundation/Icon.astro';
import { withBase } from '../../lib/site';

interface Props {
  showMenuButton?: boolean;
}

const { showMenuButton = true } = Astro.props;
---

<header class="app-header">
  <div class="app-header__inner">
    <div class="app-header__brand-row">
      {showMenuButton && (
        <button class="app-header__menu" type="button" aria-label="เปิดเมนูหลัก" data-sidebar-toggle>
          <Icon name="menu" size={22} />
        </button>
      )}
      <BrandMark />
    </div>
    <div class="app-header__meta" aria-label="สถานะข้อมูล">
      <span class="app-header__status"><span></span>ข้อมูลเผยแพร่สาธารณะ</span>
      <a href={withBase('/methodology')}>วิธีการและแหล่งข้อมูล</a>
    </div>
  </div>
</header>

<style>
  .app-header {
    position: sticky;
    z-index: 40;
    top: 0;
    height: var(--header-height);
    border-bottom: 1px solid var(--color-border);
    background: rgb(255 255 255 / 0.94);
    backdrop-filter: blur(14px);
  }

  .app-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100%, var(--content-max));
    height: 100%;
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .app-header__brand-row,
  .app-header__meta {
    display: flex;
    align-items: center;
  }

  .app-header__brand-row {
    gap: var(--space-3);
    min-width: 0;
  }

  .app-header__meta {
    gap: var(--space-6);
    color: var(--color-slate-600);
    font-size: var(--text-sm);
  }

  .app-header__meta a {
    color: var(--color-navy-800);
    font-weight: 650;
    text-decoration: none;
  }

  .app-header__meta a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  .app-header__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .app-header__status span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-green-700);
    box-shadow: 0 0 0 0.25rem var(--color-green-100);
  }

  .app-header__menu {
    display: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
    color: var(--color-navy-900);
    cursor: pointer;
  }

  @media (max-width: 900px) {
    .app-header__menu {
      display: grid;
    }

    .app-header__status {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .app-header__inner {
      padding-inline: var(--space-4);
    }

    .app-header__meta a {
      display: none;
    }
  }
</style>
