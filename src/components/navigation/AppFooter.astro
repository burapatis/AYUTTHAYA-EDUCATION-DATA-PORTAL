---
import { withBase } from '../../lib/site';
import { academicPeriod } from '../../data/fixtures';
---

<footer class="app-footer">
  <div>
    <strong>ศูนย์ข้อมูลการศึกษาจังหวัดพระนครศรีอยุธยา</strong>
    <p>จังหวัดพระนครศรีอยุธยา · {academicPeriod}</p>
    <p>นำเสนอข้อมูลเพื่อการวางแผน การตัดสินใจ และการเข้าถึงข้อมูลสาธารณะ</p>
  </div>
  <nav aria-label="เมนูส่วนท้าย">
    <a href={withBase('/methodology')}>วิธีการ</a>
    <a href={withBase('/data')}>ชุดข้อมูล</a>
    <a href={withBase('/definitions')}>นิยามข้อมูล</a>
    <a href={`${withBase('/about')}#related-resources`}>เว็บไซต์ที่เกี่ยวข้อง</a>
    <a href={withBase('/about')}>เกี่ยวกับเว็บไซต์</a>
  </nav>
</footer>

<style>
  .app-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-8);
    margin-top: var(--space-12);
    border-radius: var(--radius-xl);
    background: var(--color-navy-950);
    color: rgb(255 255 255 / 0.72);
    font-size: var(--text-xs);
  }

  .app-footer strong {
    color: var(--color-white);
    font-size: var(--text-sm);
  }

  .app-footer p {
    margin: var(--space-1) 0 0;
  }

  .app-footer nav {
    display: flex;
    gap: var(--space-5);
  }

  .app-footer a {
    color: #f8edda;
    font-weight: 650;
    text-decoration: none;
  }

  .app-footer a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  @media (max-width: 640px) {
    .app-footer {
      align-items: flex-start;
      flex-direction: column;
    }

    .app-footer nav {
      flex-wrap: wrap;
    }
  }
</style>
