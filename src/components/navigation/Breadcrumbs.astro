---
import { withBase } from '../../lib/site';

interface Breadcrumb {
  label: string;
  href?: string;
}

interface Props {
  items: Breadcrumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="เส้นทางนำทาง">
  <ol>
    {items.map((item, index) => (
      <li>
        {item.href ? <a href={withBase(item.href)}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
        {index < items.length - 1 && <span class="separator" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    color: var(--color-slate-500);
    font-size: var(--text-xs);
    list-style: none;
  }

  .breadcrumbs li {
    display: flex;
    gap: var(--space-2);
  }

  .breadcrumbs a {
    color: var(--color-slate-700);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--color-navy-900);
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  .separator {
    color: var(--color-slate-400);
  }
</style>
