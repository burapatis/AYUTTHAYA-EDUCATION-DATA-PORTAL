---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro';
import PageHeader from '../components/dashboard/PageHeader.astro';
import KpiCard from '../components/data-display/KpiCard.astro';
import ChartPanel from '../components/dashboard/ChartPanel.astro';
import SectionCard from '../components/dashboard/SectionCard.astro';
import DataTable from '../components/data-display/DataTable.astro';
import Notice from '../components/data-display/Notice.astro';
import SourceNote from '../components/data-display/SourceNote.astro';
import EChart from '../components/charts/EChart';
import { barOption, groupedBarOption } from '../lib/chart-options';
import localEducation from '../data/v1/local-education.json';
import { formatNumber, sourceLabel } from '../data/fixtures';

const activeDistricts = localEducation.districts.filter((item) => item.schools > 0);
const districtColumns = [
  { key: 'district', label: 'อำเภอ' },
  { key: 'schools', label: 'สถานศึกษา', align: 'right' as const },
  { key: 'classrooms', label: 'ห้องเรียน', align: 'right' as const },
  { key: 'teachers', label: 'ครู', align: 'right' as const },
  { key: 'students', label: 'นักเรียน', align: 'right' as const },
  { key: 'perClassroom', label: 'นักเรียน/ห้อง', align: 'right' as const },
  { key: 'perTeacher', label: 'นักเรียน/ครู', align: 'right' as const },
];
const districtRows = localEducation.districts.map((item) => ({
  district: item.districtNameTh,
  schools: formatNumber(item.schools),
  classrooms: formatNumber(item.classrooms),
  teachers: formatNumber(item.teachers),
  students: formatNumber(item.students),
  perClassroom: item.classrooms ? (item.students / item.classrooms).toFixed(1) : '—',
  perTeacher: item.teachers ? (item.students / item.teachers).toFixed(1) : '—',
}));
const levelColumns = [
  { key: 'level', label: 'ระดับการศึกษา' },
  { key: 'total', label: 'รวม', align: 'right' as const },
  { key: 'male', label: 'ชาย', align: 'right' as const },
  { key: 'female', label: 'หญิง', align: 'right' as const },
  { key: 'share', label: 'สัดส่วนผู้เรียนท้องถิ่น', align: 'right' as const },
];
const levelRows = localEducation.levels.map((item) => ({
  level: item.labelTh,
  total: formatNumber(item.total),
  male: formatNumber(item.male),
  female: formatNumber(item.female),
  share: `${((item.total / localEducation.summary.students) * 100).toFixed(1)}%`,
}));
---

<DashboardLayout title="การศึกษาสังกัดท้องถิ่น · ศูนย์ข้อมูลการศึกษาอยุธยา" activePath="/local-education">
  <Breadcrumbs items={[{ label: 'ศูนย์ข้อมูล', href: '/' }, { label: 'การศึกษาสังกัดท้องถิ่น' }]} />
  <div class="page-stack">
    <PageHeader eyebrow="Local education intelligence" title="การศึกษาสังกัดองค์กรปกครองส่วนท้องถิ่น" description="ภาพรวมทรัพยากร ผู้เรียน และการกระจายตัวรายอำเภอของกลุ่มสังกัดท้องถิ่นในจังหวัดพระนครศรีอยุธยา" period={localEducation.period.labelTh} status="ข้อมูลจากตาราง 3.1, 3.3, 3.5, 3.7 และ 3.8" />
    <Notice tone="success" title="ขอบเขตข้อมูล"><p>หน้านี้ใช้ข้อมูลคอลัมน์ “กรมส่งเสริมการปกครองส่วนท้องถิ่น” ในรายงาน โดยมีองค์กรปกครองส่วนท้องถิ่นภายในจังหวัดเป็นแหล่งข้อมูล ไม่ใช่ยอดรวมของสถานศึกษาทุกสังกัดที่ตั้งอยู่ในพื้นที่ อปท.</p></Notice>

    <section aria-label="ตัวชี้วัดการศึกษาสังกัดท้องถิ่น" class="kpi-grid">
      <KpiCard label="สถานศึกษา" value={formatNumber(localEducation.summary.schools)} unit="แห่ง" detail={`กระจายใน ${localEducation.summary.districtsWithSchools} อำเภอ`} icon="school" featured />
      <KpiCard label="ห้องเรียน" value={formatNumber(localEducation.summary.classrooms)} unit="ห้อง" detail="10.1% ของยอดจังหวัด" icon="trend" />
      <KpiCard label="ครู" value={formatNumber(localEducation.summary.teachers)} unit="คน" detail="7.9% ของยอดจังหวัด" icon="teachers" />
      <KpiCard label="นักเรียน" value={formatNumber(localEducation.summary.students)} unit="คน" detail="9.3% ของยอดจังหวัด" icon="students" />
    </section>

    <SectionCard title="สัดส่วนเมื่อเทียบกับยอดจังหวัด" description="ตัวตั้งและตัวหารมาจากตารางปีการศึกษาและหน่วยเดียวกัน">
      <div class="share-grid">
        <article><span>สถานศึกษา</span><strong>{localEducation.summary.provinceSharesPercent.schools}%</strong><p>26 จาก 426 แห่ง</p></article>
        <article><span>ห้องเรียน</span><strong>{localEducation.summary.provinceSharesPercent.classrooms}%</strong><p>564 จาก 5,610 ห้อง</p></article>
        <article><span>ครู</span><strong>{localEducation.summary.provinceSharesPercent.teachers}%</strong><p>582 จาก 7,358 คน</p></article>
        <article><span>นักเรียน</span><strong>{localEducation.summary.provinceSharesPercent.students}%</strong><p>10,742 จาก 115,123 คน</p></article>
      </div>
    </SectionCard>

    <div class="content-grid">
      <ChartPanel title="นักเรียนสังกัดท้องถิ่นรายอำเภอ" description="แสดงเฉพาะ 6 อำเภอที่ตารางรายงานว่ามีสถานศึกษากลุ่มสังกัดนี้" height={360}>
        <EChart client:visible option={barOption(activeDistricts.map((item) => item.districtNameTh), activeDistricts.map((item) => item.students), 'นักเรียน', { horizontal: true, color: '#1769aa', unit: 'คน', gridLeft: 110 })} label="กราฟจำนวนนักเรียนสังกัดท้องถิ่นจำแนกรายอำเภอ" />
      </ChartPanel>
      <ChartPanel title="นักเรียนตามระดับและเพศ" description="องค์ประกอบผู้เรียนในกลุ่มสังกัดท้องถิ่น" height={360}>
        <EChart client:visible option={groupedBarOption(localEducation.levels.map((item) => item.labelTh), [
          { name: 'ชาย', data: localEducation.levels.map((item) => item.male), color: '#1769aa' },
          { name: 'หญิง', data: localEducation.levels.map((item) => item.female), color: '#bd8422' },
        ])} label="กราฟนักเรียนสังกัดท้องถิ่นจำแนกตามระดับการศึกษาและเพศ" />
      </ChartPanel>
    </div>

    <SectionCard title="โครงสร้างผู้เรียนตามระดับการศึกษา" description="ยอดชายและหญิงรวมกันเท่ากับยอดรวมของแต่ละระดับ">
      <DataTable caption="นักเรียนสังกัดท้องถิ่นจำแนกตามระดับการศึกษาและเพศ" columns={levelColumns} rows={levelRows} compact />
    </SectionCard>

    <SectionCard title="ข้อมูลสังกัดท้องถิ่นครบ 16 อำเภอ" description="ค่าอัตราส่วนเป็นค่าคำนวณจากยอดรายอำเภอและปัดทศนิยมหนึ่งตำแหน่ง">
      <DataTable caption="สถานศึกษา ห้องเรียน ครู และนักเรียนสังกัดท้องถิ่นรายอำเภอ" columns={districtColumns} rows={districtRows} compact />
    </SectionCard>

    <div class="ratio-strip" aria-label="อัตราส่วนทรัพยากรสังกัดท้องถิ่น">
      <article><span>นักเรียนต่อห้องเรียน</span><strong>{localEducation.summary.studentsPerClassroomDerived.toFixed(1)} : 1</strong><p>คำนวณจาก 10,742 ÷ 564</p></article>
      <article><span>นักเรียนต่อครู</span><strong>{localEducation.summary.studentsPerTeacherDerived.toFixed(1)} : 1</strong><p>คำนวณจาก 10,742 ÷ 582</p></article>
      <article><span>องค์ประกอบเพศ</span><strong>{((localEducation.summary.femaleStudents / localEducation.summary.students) * 100).toFixed(1)}% หญิง</strong><p>หญิง 5,177 คน · ชาย 5,565 คน</p></article>
    </div>

    <Notice tone="warning" title="อ่านค่า 0 ให้ถูกต้อง"><p>ค่า 0 ในตารางหมายถึงตารางต้นทางไม่รายงานสถานศึกษาใน “กลุ่มสังกัดท้องถิ่น” ของอำเภอนั้น ไม่ได้หมายความว่าอำเภอนั้นไม่มีสถานศึกษาหรือบริการการศึกษาจากสังกัดอื่น</p></Notice>
    <SourceNote source={sourceLabel} period={localEducation.period.labelTh} table="ตาราง 3.1, 3.3, 3.5, 3.7 และ 3.8" note="อัตราส่วนและร้อยละบนหน้านี้เป็นค่าคำนวณจากยอดในตารางต้นทาง; รายละเอียดนิยามและเงื่อนไขการเปรียบเทียบอยู่ในหน้าพจนานุกรมข้อมูล" />
  </div>
</DashboardLayout>

<style>
  .share-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); border:1px solid var(--color-border); border-radius:var(--radius-lg); background:var(--color-white); }
  .share-grid article { padding:var(--space-5); border-right:1px solid var(--color-border); }
  .share-grid article:last-child { border-right:0; }
  .share-grid span,.ratio-strip span { color:var(--color-slate-500); font-size:var(--text-xs); font-weight:700; }
  .share-grid strong { display:block; margin:var(--space-2) 0; color:var(--color-navy-900); font-size:clamp(1.65rem,3vw,2.35rem); font-variant-numeric:tabular-nums; }
  .share-grid p,.ratio-strip p { margin:0; color:var(--color-slate-500); font-size:var(--text-xs); }
  .ratio-strip { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); overflow:hidden; border:1px solid var(--color-border); border-radius:var(--radius-lg); background:linear-gradient(135deg,var(--color-navy-900),#133b63); box-shadow:var(--shadow-sm); }
  .ratio-strip article { padding:var(--space-6); border-right:1px solid rgb(255 255 255 / .14); }
  .ratio-strip article:last-child { border-right:0; }
  .ratio-strip span,.ratio-strip p { color:rgb(255 255 255 / .7); }
  .ratio-strip strong { display:block; margin:var(--space-2) 0; color:var(--color-white); font-size:var(--text-xl); font-variant-numeric:tabular-nums; }
  @media (max-width:760px) {
    .share-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .share-grid article:nth-child(2) { border-right:0; }
    .share-grid article:nth-child(-n+2) { border-bottom:1px solid var(--color-border); }
    .ratio-strip { grid-template-columns:minmax(0,1fr); }
    .ratio-strip article { border-right:0; border-bottom:1px solid rgb(255 255 255 / .14); }
    .ratio-strip article:last-child { border-bottom:0; }
  }
</style>
