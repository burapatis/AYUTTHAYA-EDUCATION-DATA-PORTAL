---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro';
import PageHeader from '../components/dashboard/PageHeader.astro';
import SectionCard from '../components/dashboard/SectionCard.astro';
import Notice from '../components/data-display/Notice.astro';
import SourceNote from '../components/data-display/SourceNote.astro';
import { sourceLabel } from '../data/fixtures';
---

<DashboardLayout title="วิธีการและแหล่งข้อมูล · ศูนย์ข้อมูลการศึกษาอยุธยา" activePath="/methodology">
  <Breadcrumbs items={[{ label: 'ศูนย์ข้อมูล', href: '/' }, { label: 'วิธีการและแหล่งข้อมูล' }]} />
  <div class="page-stack">
    <PageHeader eyebrow="Methodology and provenance" title="วิธีการและแหล่งข้อมูล" description="หลักเกณฑ์การถอดข้อมูล คำนวณตัวชี้วัด และสื่อสารข้อจำกัดอย่างโปร่งใส" status="ตรวจสอบย้อนกลับได้" />
    <div class="narrative-grid">
      <article class="narrative-card"><span class="narrative-card__index">01</span><h2>ยึดรายงานเป็นต้นทาง</h2><p>ถอดค่าจากตารางการศึกษาในรายงานสถิติจังหวัด พ.ศ. 2568 และคงชื่อหน่วยกับรอบเวลาเดิม</p></article>
      <article class="narrative-card"><span class="narrative-card__index">02</span><h2>แยกรอบเวลา</h2><p>ไม่รวมปีการศึกษา ปีงบประมาณ และปีปฏิทินเข้าด้วยกัน แต่แสดงรอบอ้างอิงของแต่ละตัวชี้วัดเสมอ</p></article>
      <article class="narrative-card"><span class="narrative-card__index">03</span><h2>ตรวจยอดรวม</h2><p>เปรียบเทียบยอดรายหมวดและรายอำเภอกับยอดจังหวัด พร้อมบันทึกข้อแตกต่างแทนการแก้ตัวเลขต้นทาง</p></article>
    </div>
    <SectionCard title="นิยามและการคำนวณ">
      <dl class="metric-definition">
        <dt>นักเรียนต่อห้องเรียน</dt><dd>จำนวนนักเรียนรวมหารด้วยจำนวนห้องเรียน แล้วแสดงเป็นจำนวนคนต่อหนึ่งห้องตามค่าที่รายงาน</dd>
        <dt>นักเรียนต่อครู</dt><dd>จำนวนนักเรียนรวมหารด้วยจำนวนครู แล้วแสดงเป็นจำนวนคนต่อครูหนึ่งคนตามค่าที่รายงาน</dd>
        <dt>การเปลี่ยนแปลงรายปี</dt><dd>(ค่าปีล่าสุด − ค่าปีก่อน) ÷ ค่าปีก่อน × 100 โดยปัดทศนิยมหนึ่งตำแหน่ง</dd>
        <dt>ค่าที่ขาดหาย</dt><dd>แสดงเป็น “—” และไม่แทนเป็นศูนย์ เพราะศูนย์เป็นค่าข้อมูลที่มีความหมายต่างจากไม่พบข้อมูล</dd>
      </dl>
    </SectionCard>
    <Notice tone="warning" title="ข้อสังเกตจากเอกสารต้นทาง"><p>ตาราง 3.10 มีปีในหัวภาษาอังกฤษไม่ตรงกับหัวภาษาไทย, ตาราง 3.12 ไม่ระบุปีในชื่อเรื่อง, ชื่ออำเภอบางไทรและบางซ้ายถอดเป็นภาษาอังกฤษซ้ำกัน และไฟล์ประชากรประกอบมีชุดแถวซ้ำพร้อมรหัสงวดที่ต้องยืนยันก่อนเผยแพร่</p></Notice>
    <SectionCard title="แนวทางประกันคุณภาพ" description="ขั้นตอนที่ใช้ก่อนนำข้อมูลขึ้นหน้าเผยแพร่">
      <ul class="plain-list"><li>เก็บหน่วยและปีอ้างอิงแยกจากค่าตัวเลข</li><li>ตรวจผลรวมระหว่างเพศ ระดับ สังกัด อำเภอ และยอดจังหวัด</li><li>ระบุชัดเจนเมื่อค่าบนหน้าเป็นการคำนวณ ไม่ใช่ค่าที่พิมพ์ในรายงาน</li><li>เก็บรหัสคงที่และบันทึกแหล่งที่มาเพื่อรองรับการอัปเดตในอนาคต</li></ul>
    </SectionCard>
    <SourceNote source={sourceLabel} period="รายงานเผยแพร่ พ.ศ. 2568" table="บทที่ 3 และตาราง 7.4" note="ข้อสังเกตทั้งหมดคงไว้เพื่อความโปร่งใสและควรตรวจยืนยันกับหน่วยงานเจ้าของข้อมูล" />
  </div>
</DashboardLayout>
