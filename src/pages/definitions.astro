---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro';
import PageHeader from '../components/dashboard/PageHeader.astro';
import Notice from '../components/data-display/Notice.astro';
import DefinitionCard from '../components/data-display/DefinitionCard.astro';
import SourceNote from '../components/data-display/SourceNote.astro';
import definitions from '../data/v1/definitions.json';
import { sourceLabel } from '../data/fixtures';
---

<DashboardLayout title="นิยามข้อมูล · ศูนย์ข้อมูลการศึกษาอยุธยา" activePath="/definitions">
  <Breadcrumbs items={[{ label: 'ศูนย์ข้อมูล', href: '/' }, { label: 'นิยามข้อมูล' }]} />
  <div class="page-stack">
    <PageHeader eyebrow="Education data dictionary" title="นิยามข้อมูล" description="ความหมาย หน่วย สูตร และเงื่อนไขที่ต้องตรวจสอบก่อนนำข้อมูลไปใช้หรือเปรียบเทียบกับแหล่งอื่น" status="พจนานุกรมข้อมูล เวอร์ชัน 1" />
    <Notice tone="success" title="หลักสำคัญก่อนเปรียบเทียบ"><p>ควรใช้ข้อมูลที่มีรอบเวลา หน่วย พื้นที่ ระดับการศึกษา และสังกัดเดียวกัน พร้อมแยกค่าที่รายงานออกจากค่าที่เว็บไซต์คำนวณ</p></Notice>

    <section class="dictionary-tools" aria-label="ค้นหาและเลือกหมวดนิยาม">
      <label for="definition-search">ค้นหาคำหรือตัวชี้วัด</label>
      <input id="definition-search" type="search" placeholder="เช่น นักเรียนต่อครู, ปีการศึกษา, ไม่มีข้อมูล" autocomplete="off" data-definition-search />
      <nav aria-label="หมวดนิยามข้อมูล">
        {definitions.categories.map((category) => <a href={`#category-${category.id}`}>{category.labelTh}</a>)}
      </nav>
      <p aria-live="polite" data-definition-result>แสดงนิยามทั้งหมด {definitions.categories.reduce((total, category) => total + category.definitions.length, 0)} รายการ</p>
    </section>

    <div data-definition-groups>
      {definitions.categories.map((category) => (
        <section class="definition-section" id={`category-${category.id}`} data-definition-group>
          <div class="definition-section__heading">
            <div><span>Data dictionary</span><h2>{category.labelTh}</h2></div>
            <strong>{category.definitions.length} รายการ</strong>
          </div>
          <div class="definition-grid">
            {category.definitions.map((item) => (
              <DefinitionCard
                id={item.id}
                term={item.termTh}
                definition={item.definitionTh}
                unit={item.unitTh}
                comparison={item.comparisonTh}
                formula={'formula' in item ? item.formula : undefined}
                sourceTables={item.sourceTables}
                valueType={item.valueType}
              />
            ))}
          </div>
        </section>
      ))}
    </div>

    <p class="empty-state" hidden data-definition-empty>ไม่พบนิยามที่ตรงกับคำค้น ลองใช้คำสั้นลงหรือเลือกจากหมวดด้านบน</p>
    <SourceNote source={sourceLabel} period="ใช้กับชุดข้อมูลเว็บไซต์เวอร์ชัน 1" table="ตาราง 3.1–3.16 และ 7.4" note="นิยามเป็นนิยามเชิงปฏิบัติการสำหรับการใช้ข้อมูลบนเว็บไซต์ ควรตรวจนิยามของแหล่งอื่นทุกครั้งก่อนเปรียบเทียบ" />
  </div>
</DashboardLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-definition-search]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-definition-card]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-definition-group]')];
  const result = document.querySelector<HTMLElement>('[data-definition-result]');
  const empty = document.querySelector<HTMLElement>('[data-definition-empty]');

  search?.addEventListener('input', () => {
    const query = search.value.trim().toLocaleLowerCase('th');
    let visible = 0;
    cards.forEach((card) => {
      const matches = !query || (card.dataset.search ?? '').includes(query);
      card.hidden = !matches;
      if (matches) visible += 1;
    });
    groups.forEach((group) => {
      group.hidden = !group.querySelector('[data-definition-card]:not([hidden])');
    });
    if (result) result.textContent = `แสดง ${visible} รายการ${query ? ` สำหรับ “${search.value.trim()}”` : ''}`;
    if (empty) empty.hidden = visible !== 0;
  });
</script>

<style>
  .dictionary-tools { display:grid; gap:var(--space-3); padding:var(--space-5); border:1px solid var(--color-border); border-radius:var(--radius-lg); background:var(--color-white); box-shadow:var(--shadow-xs); }
  .dictionary-tools label { color:var(--color-navy-900); font-size:var(--text-sm); font-weight:750; }
  .dictionary-tools input { width:100%; padding:.82rem var(--space-4); border:1px solid var(--color-slate-300); border-radius:var(--radius-md); background:var(--color-white); color:var(--color-navy-900); font:inherit; }
  .dictionary-tools input:focus { border-color:var(--color-blue-600); outline:3px solid var(--color-blue-100); }
  .dictionary-tools nav { display:flex; flex-wrap:wrap; gap:var(--space-2); }
  .dictionary-tools a { padding:.38rem .7rem; border:1px solid var(--color-border); border-radius:999px; background:var(--color-slate-50); color:var(--color-slate-700); font-size:var(--text-xs); font-weight:700; text-decoration:none; }
  .dictionary-tools a:hover { border-color:var(--color-blue-600); color:var(--color-blue-700); }
  .dictionary-tools p { margin:0; color:var(--color-slate-500); font-size:var(--text-xs); }
  .definition-section { scroll-margin-top:calc(var(--header-height) + var(--space-5)); }
  .definition-section + .definition-section { margin-top:var(--space-10); }
  .definition-section__heading { display:flex; align-items:end; justify-content:space-between; gap:var(--space-4); margin-bottom:var(--space-4); }
  .definition-section__heading span { color:var(--color-gold-600); font-size:var(--text-xs); font-weight:800; letter-spacing:.07em; text-transform:uppercase; }
  .definition-section__heading h2 { margin:var(--space-1) 0 0; color:var(--color-navy-900); font-size:var(--text-xl); }
  .definition-section__heading > strong { color:var(--color-slate-500); font-size:var(--text-xs); }
  .definition-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--space-4); }
  .empty-state { padding:var(--space-8); border:1px dashed var(--color-slate-300); border-radius:var(--radius-lg); background:var(--color-slate-50); color:var(--color-slate-600); text-align:center; }
  [hidden] { display:none !important; }
  @media (max-width:760px) { .definition-grid { grid-template-columns:minmax(0,1fr); } }
</style>
