---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro';
import PageHeader from '../components/dashboard/PageHeader.astro';
import KpiCard from '../components/data-display/KpiCard.astro';
import ChartPanel from '../components/dashboard/ChartPanel.astro';
import SectionCard from '../components/dashboard/SectionCard.astro';
import DataTable from '../components/data-display/DataTable.astro';
import SourceNote from '../components/data-display/SourceNote.astro';
import EChart from '../components/charts/EChart';
import { donutOption, groupedBarOption, lineOption } from '../lib/chart-options';
import { academicPeriod, formatNumber, sourceLabel, teacherLevels, teacherQualifications, teacherTrend } from '../data/fixtures';

const totalMale = teacherLevels.reduce((sum, item) => sum + item.male, 0);
const totalFemale = teacherLevels.reduce((sum, item) => sum + item.female, 0);
const columns = [{ key: 'level', label: 'ระดับที่สอน' }, { key: 'male', label: 'ชาย', align: 'right' as const }, { key: 'female', label: 'หญิง', align: 'right' as const }, { key: 'total', label: 'รวม', align: 'right' as const }];
const rows = teacherLevels.map((item) => ({ level: item.label, male: formatNumber(item.male), female: formatNumber(item.female), total: formatNumber(item.total) }));
---

<DashboardLayout title="ครูและบุคลากร · ศูนย์ข้อมูลการศึกษาอยุธยา" activePath="/teachers">
  <Breadcrumbs items={[{ label: 'ศูนย์ข้อมูล', href: '/' }, { label: 'ครูและบุคลากร' }]} />
  <div class="page-stack">
    <PageHeader eyebrow="Education workforce" title="ครูและบุคลากร" description="ภาพรวมกำลังคน คุณวุฒิ และระดับการสอน เพื่อสนับสนุนการวางแผนทรัพยากร" period={academicPeriod} status="ข้อมูลจากรายงานทางการ" />
    <section aria-label="ตัวชี้วัดครู" class="kpi-grid">
      <KpiCard label="ครูทั้งหมด" value="7,358" unit="คน" detail="ทุกระดับการศึกษา" icon="teachers" featured />
      <KpiCard label="ครูหญิง" value={formatNumber(totalFemale)} unit="คน" detail="75.1% ของครูทั้งหมด" icon="teachers" />
      <KpiCard label="ครูชาย" value={formatNumber(totalMale)} unit="คน" detail="24.9% ของครูทั้งหมด" icon="teachers" />
      <KpiCard label="นักเรียนต่อครู" value="16 : 1" detail="อัตราส่วนระดับจังหวัด" icon="students" />
    </section>
    <div class="content-grid">
      <ChartPanel title="คุณวุฒิครู" description="จำนวนครูจำแนกตามวุฒิการศึกษาสูงสุด" height={360}>
        <EChart client:visible option={donutOption(teacherQualifications.map((item) => ({ name: item.label, value: item.value })))} label="แผนภูมิวงแหวนคุณวุฒิครู" />
      </ChartPanel>
      <ChartPanel title="ครูตามระดับที่สอนและเพศ" description="เปรียบเทียบองค์ประกอบกำลังคน" height={360}>
        <EChart client:visible option={groupedBarOption(teacherLevels.map((item) => item.label), [{ name: 'ชาย', data: teacherLevels.map((item) => item.male) }, { name: 'หญิง', data: teacherLevels.map((item) => item.female), color: '#bd8422' }])} label="กราฟครูชายหญิงแยกตามระดับที่สอน" />
      </ChartPanel>
    </div>
    <ChartPanel title="แนวโน้มจำนวนครู 5 ปี" description="ปีการศึกษา 2563–2567" height={320}>
      <EChart client:visible option={lineOption(teacherTrend.map((item) => item.year), teacherTrend.map((item) => item.total), 'ครู')} label="กราฟแนวโน้มจำนวนครูห้าปี" />
    </ChartPanel>
    <SectionCard title="ครูจำแนกตามระดับที่สอน" description="ผลรวมทุกระดับตรงกับยอดจังหวัด">
      <DataTable caption="จำนวนครูแยกตามระดับที่สอนและเพศ" columns={columns} rows={rows} />
    </SectionCard>
    <SourceNote source={sourceLabel} period={academicPeriod} table="ตาราง 3.6–3.9 และ 7.4" note="อัตราส่วนนักเรียนต่อครูใช้ยอดนักเรียนและครูรวมของจังหวัด" />
  </div>
</DashboardLayout>
