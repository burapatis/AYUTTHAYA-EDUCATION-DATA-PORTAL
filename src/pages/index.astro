---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro';
import PageHeader from '../components/dashboard/PageHeader.astro';
import KpiCard from '../components/data-display/KpiCard.astro';
import ChartPanel from '../components/dashboard/ChartPanel.astro';
import NavigationCard from '../components/dashboard/NavigationCard.astro';
import SectionCard from '../components/dashboard/SectionCard.astro';
import DataTable from '../components/data-display/DataTable.astro';
import SourceNote from '../components/data-display/SourceNote.astro';
import EChart from '../components/charts/EChart';
import { barOption, lineOption } from '../lib/chart-options';
import { withBase } from '../lib/site';
import { academicPeriod, districtRows, formatNumber, provinceSummary, sourceLabel, studentLevels, studentTrend, teacherTrend } from '../data/fixtures';

const topDistricts = [...districtRows].sort((a, b) => b.students - a.students).slice(0, 5);
const mostStudents = topDistricts[0];
const leastStudents = [...districtRows].sort((a, b) => a.students - b.students)[0];
const previousStudents = studentTrend.at(-2);
const latestStudents = studentTrend.at(-1);
const studentChangePercent = previousStudents && latestStudents
  ? ((latestStudents.total - previousStudents.total) / previousStudents.total) * 100
  : 0;
const largestShare = mostStudents ? (mostStudents.students / provinceSummary.students) * 100 : 0;
const previousTeachers = teacherTrend.at(-2);
const latestTeachers = teacherTrend.at(-1);
const teacherChangePercent = previousTeachers && latestTeachers
  ? ((latestTeachers.total - previousTeachers.total) / previousTeachers.total) * 100
  : 0;
const districtColumns = [
  { key: 'district', label: 'อำเภอ' },
  { key: 'schools', label: 'สถานศึกษา', align: 'right' as const },
  { key: 'teachers', label: 'ครู', align: 'right' as const },
  { key: 'students', label: 'นักเรียน', align: 'right' as const },
];
const districtTable = topDistricts.map((row) => ({ district: row.name, schools: formatNumber(row.schools), teachers: formatNumber(row.teachers), students: formatNumber(row.students) }));
---

<DashboardLayout title="ภาพรวม · ศูนย์ข้อมูลการศึกษาจังหวัดพระนครศรีอยุธยา" description="ภาพรวมตัวชี้วัดการศึกษาจังหวัดพระนครศรีอยุธยา" activePath="/">
  <Breadcrumbs items={[{ label: 'ศูนย์ข้อมูล' }, { label: 'ภาพรวม' }]} />
  <div class="page-stack">
    <section class="insight-band" aria-label="ข้อค้นพบสำคัญ">
      <div class="insight-band__intro">
        <p>Key findings</p>
        <h2>ข้อค้นพบจากข้อมูลปีล่าสุด</h2>
        <p>
          {academicPeriod} จังหวัดมีนักเรียน {formatNumber(provinceSummary.students)} คน{' '}
          {studentChangePercent < 0 ? `ลดลง ${Math.abs(studentChangePercent).toFixed(1)}% จากปีก่อน` : `เปลี่ยน ${studentChangePercent.toFixed(1)}% จากปีก่อน`}
          {mostStudents && leastStudents && ` โดยอำเภอ${mostStudents.name}มีนักเรียนมากที่สุด และอำเภอ${leastStudents.name}มีน้อยที่สุด`}
        </p>
      </div>
      <div class="insight-band__findings">
        <article>
          <span>แนวโน้มนักเรียน</span>
          <strong>{studentChangePercent < 0 ? '−' : '+'}{Math.abs(studentChangePercent).toFixed(1)}%</strong>
          <p>{previousStudents && latestStudents ? `จาก ${formatNumber(previousStudents.total)} คน ในปี ${previousStudents.year}` : academicPeriod}</p>
          <a href={withBase('/students')}>ดูโครงสร้างนักเรียน</a>
        </article>
        <article>
          <span>นักเรียนมากที่สุด</span>
          <strong>{mostStudents ? mostStudents.name : '—'}</strong>
          <p>{mostStudents ? `${formatNumber(mostStudents.students)} คน · ${largestShare.toFixed(1)}% ของจังหวัด` : ''}</p>
          <a href={withBase('/districts')}>ดูแผนที่อำเภอ</a>
        </article>
        <article>
          <span>นักเรียนน้อยที่สุด</span>
          <strong>{leastStudents ? leastStudents.name : '—'}</strong>
          <p>{leastStudents ? `${formatNumber(leastStudents.students)} คน · นักเรียนต่อครู ${leastStudents.studentsPerTeacher} คน` : ''}</p>
          <a href={withBase('/districts')}>เปรียบเทียบ 16 อำเภอ</a>
        </article>
      </div>
    </section>
    <PageHeader eyebrow="Provincial education intelligence" title="ภาพรวมการศึกษาจังหวัดพระนครศรีอยุธยา" description="ข้อมูลเพื่อมองเห็นขนาดระบบการศึกษา แนวโน้ม และความแตกต่างเชิงพื้นที่อย่างโปร่งใส" period={academicPeriod} status="ข้อมูลจากรายงานทางการ" />
    <section aria-label="ตัวชี้วัดหลัก" class="kpi-grid">
      <KpiCard label="สถานศึกษา" value={formatNumber(provinceSummary.schools)} unit="แห่ง" detail="ครอบคลุม 16 อำเภอ" icon="school" featured href="/schools" />
      <KpiCard label="ห้องเรียน" value={formatNumber(provinceSummary.classrooms)} unit="ห้อง" detail="ทุกสังกัด" icon="trend" href="/schools" />
      <KpiCard label="ครู" value={formatNumber(provinceSummary.teachers)} unit="คน" detail="เฉลี่ยนักเรียน 16 คนต่อครู" icon="teachers" href="/teachers" trend={teacherChangePercent < 0 ? `ค่าคำนวณ: ลดลง ${Math.abs(teacherChangePercent).toFixed(1)}% จากปีก่อน` : `ค่าคำนวณ: เพิ่ม ${teacherChangePercent.toFixed(1)}% จากปีก่อน`} trendDirection={teacherChangePercent < 0 ? 'down' : teacherChangePercent > 0 ? 'up' : 'neutral'} />
      <KpiCard label="นักเรียน" value={formatNumber(provinceSummary.students)} unit="คน" detail="ปีการศึกษา 2567" trend="ค่าคำนวณ: ลดลง 4.2% จากปีก่อน" trendDirection="down" icon="students" href="/students" />
    </section>
    <div class="content-grid">
      <ChartPanel title="แนวโน้มจำนวนนักเรียน" description="จำนวนนักเรียนทุกสังกัด ปีการศึกษา 2563–2567" height={330}>
        <EChart client:visible option={lineOption(studentTrend.map((item) => item.year), studentTrend.map((item) => item.total), 'นักเรียน')} label="กราฟแนวโน้มจำนวนนักเรียนจังหวัดพระนครศรีอยุธยา" />
        <details slot="footer" class="chart-table-toggle"><summary>ดูข้อมูลในรูปแบบตาราง</summary><table><thead><tr><th>ปีการศึกษา</th><th>นักเรียน (คน)</th></tr></thead><tbody>{studentTrend.map((item) => <tr><td>{item.year}</td><td>{formatNumber(item.total)}</td></tr>)}</tbody></table></details>
      </ChartPanel>
      <ChartPanel title="นักเรียนตามระดับการศึกษา" description="องค์ประกอบนักเรียนในระบบ ปีการศึกษา 2567" height={330}>
        <EChart client:visible option={barOption(studentLevels.map((item) => item.label), studentLevels.map((item) => item.total), 'นักเรียน')} label="กราฟจำนวนนักเรียนจำแนกตามระดับการศึกษา" />
        <details slot="footer" class="chart-table-toggle"><summary>ดูข้อมูลในรูปแบบตาราง</summary><table><thead><tr><th>ระดับ</th><th>นักเรียน (คน)</th></tr></thead><tbody>{studentLevels.map((item) => <tr><td>{item.label}</td><td>{formatNumber(item.total)}</td></tr>)}</tbody></table></details>
      </ChartPanel>
    </div>
    <section aria-labelledby="explore-title">
      <div class="section-heading"><div><p>สำรวจข้อมูล</p><h2 id="explore-title">เจาะลึกประเด็นสำคัญ</h2></div></div>
      <div class="navigation-grid">
        <NavigationCard href="/districts" eyebrow="Spatial equity" title="เปรียบเทียบ 16 อำเภอ" description="สำรวจขนาดระบบและอัตราส่วนนักเรียนต่อทรัพยากร" icon="districts" />
        <NavigationCard href="/students" eyebrow="Learners" title="โครงสร้างนักเรียน" description="ติดตามระดับชั้น เพศ และแนวโน้มระยะห้าปี" icon="students" />
        <NavigationCard href="/teachers" eyebrow="Workforce" title="ครูและบุคลากร" description="ดูคุณวุฒิ ระดับที่สอน และภาระนักเรียนต่อครู" icon="teachers" />
        <NavigationCard href="/access-and-dropout" title="การเข้าถึงและออกกลางคัน" description="ติดตามแนวโน้มและสาเหตุที่รายงาน" icon="trend" />
        <NavigationCard href="/higher-education" title="อาชีวะและอุดมศึกษา" description="ภาพรวมสถาบัน อาจารย์ และผู้เรียนหลังการศึกษาขั้นพื้นฐาน" icon="graduate" />
        <NavigationCard href="/lifelong-learning" title="การเรียนรู้ตลอดชีวิต" description="กิจกรรมการศึกษานอกระบบและการพัฒนาทักษะ" icon="learning" />
        <NavigationCard href="/local-education" eyebrow="Local administration" title="การศึกษาสังกัดท้องถิ่น" description="ดูสถานศึกษา ห้องเรียน ครู และนักเรียนของกลุ่มสังกัด อปท. รายอำเภอ" icon="local" />
        <NavigationCard href="/special-education" eyebrow="Special education" title="การศึกษาพิเศษ" description="ศูนย์การศึกษาพิเศษประจำจังหวัด ในสังกัดสำนักบริหารงานการศึกษาพิเศษ สพฐ. ตัวเลขแยกยังไม่ได้นำเข้า" icon="special" />
        <NavigationCard href="/definitions" eyebrow="Data dictionary" title="นิยามข้อมูล" description="ตรวจความหมาย หน่วย สูตร และเงื่อนไขก่อนนำข้อมูลไปเปรียบเทียบ" icon="info" />
      </div>
    </section>
    <SectionCard title="อำเภอที่มีนักเรียนมากที่สุด" description="ห้าอันดับแรกจากข้อมูลรายอำเภอ ปีการศึกษา 2567">
      <DataTable caption="อำเภอที่มีนักเรียนมากที่สุด" columns={districtColumns} rows={districtTable} meterKey="students" />
    </SectionCard>
    <SourceNote source={sourceLabel} period={academicPeriod} table="ตาราง 3.1–3.9 และ 7.4" note="ค่าทั้งหมดถอดจากรายงานต้นทาง; รายละเอียดโครงสร้างไฟล์ข้อมูลจะจัดทำใน Step 6" />
  </div>
</DashboardLayout>

<style>
  .insight-band {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    background: linear-gradient(135deg, var(--color-navy-950), var(--color-navy-800) 62%, #1a4d78);
    color: var(--color-white);
  }

  .insight-band__intro p:first-child {
    margin-bottom: var(--space-2);
    color: var(--color-gold-500);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .insight-band h2 {
    margin: 0;
    color: var(--color-white);
    font-size: var(--text-2xl);
  }

  .insight-band__intro p:last-child {
    max-width: 46rem;
    margin: var(--space-3) 0 0;
    color: rgb(255 255 255 / 0.78);
  }

  .insight-band__findings {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .insight-band article {
    padding: var(--space-5);
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.06);
  }

  .insight-band article span,
  .insight-band article p {
    color: rgb(255 255 255 / 0.72);
    font-size: var(--text-xs);
  }

  .insight-band article strong {
    display: block;
    margin: var(--space-2) 0;
    color: var(--color-white);
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    letter-spacing: -0.03em;
  }

  .insight-band article p { margin: 0; }

  .insight-band article a {
    display: inline-block;
    margin-top: var(--space-4);
    color: #f8edda;
    font-size: var(--text-xs);
    font-weight: 750;
    text-decoration: none;
  }

  .insight-band article a:hover { text-decoration: underline; text-underline-offset: 0.2rem; }

  @media (max-width: 760px) {
    .insight-band { padding: var(--space-5); }
    .insight-band__findings { grid-template-columns: minmax(0, 1fr); }
  }

  .section-heading { display:flex; justify-content:space-between; margin-bottom:var(--space-4); }
  .section-heading p { margin:0 0 var(--space-1); color:var(--color-gold-600); font-size:var(--text-xs); font-weight:800; letter-spacing:.07em; text-transform:uppercase; }
  .section-heading h2 { margin:0; font-size:var(--text-xl); }
</style>
