---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro';
import PageHeader from '../components/dashboard/PageHeader.astro';
import SectionCard from '../components/dashboard/SectionCard.astro';
import NavigationCard from '../components/dashboard/NavigationCard.astro';
import Notice from '../components/data-display/Notice.astro';
---

<DashboardLayout
  title="เกี่ยวกับเว็บไซต์นี้ · ศูนย์ข้อมูลการศึกษาอยุธยา"
  description="ผู้จัดทำ วัตถุประสงค์ และแหล่งข้อมูลอ้างอิงของศูนย์ข้อมูลการศึกษาจังหวัดพระนครศรีอยุธยา"
  activePath="/about"
>
  <Breadcrumbs items={[{ label: 'ศูนย์ข้อมูล', href: '/' }, { label: 'เกี่ยวกับเว็บไซต์นี้' }]} />
  <div class="page-stack">
    <PageHeader
      eyebrow="About this website"
      title="เกี่ยวกับเว็บไซต์นี้"
      description="โครงการอิสระเพื่อศึกษา วิจัย และพัฒนาแหล่งแลกเปลี่ยนเรียนรู้ด้านการศึกษาของจังหวัดพระนครศรีอยุธยา"
      status="โครงการวิจัยอิสระ"
    />

    <SectionCard title="ผู้จัดทำเว็บไซต์" description="ผู้ริเริ่ม ออกแบบ และพัฒนาศูนย์ข้อมูลแห่งนี้">
      <div class="creator-profile">
        <div class="creator-profile__mark" aria-hidden="true">บพ</div>
        <div class="creator-profile__content">
          <p class="creator-profile__role">ผู้วิจัยอิสระ</p>
          <h3>บูรพาทิศ พลอยสุวรรณ์</h3>
          <p>จัดทำเว็บไซต์เพื่อศึกษาวิจัย พัฒนาองค์ความรู้ และส่งเสริมการใช้ข้อมูลการศึกษาอย่างสร้างสรรค์ โดยมุ่งให้เกิดประโยชน์ต่อสาธารณะและการศึกษาของจังหวัดพระนครศรีอยุธยา</p>
          <address>
            <span>ติดต่อผู้จัดทำ</span>
            <a href="mailto:burapatis@gmail.com">burapatis@gmail.com</a>
          </address>
        </div>
      </div>
    </SectionCard>

    <div class="narrative-grid" aria-label="วัตถุประสงค์ของเว็บไซต์">
      <article class="narrative-card"><span class="narrative-card__index">01</span><h2>ศึกษาและวิจัย</h2><p>นำข้อมูลสถิติมาจัดระบบ วิเคราะห์ และสื่อสารในรูปแบบที่ช่วยให้มองเห็นภาพรวมและประเด็นสำคัญทางการศึกษา</p></article>
      <article class="narrative-card"><span class="narrative-card__index">02</span><h2>แลกเปลี่ยนเรียนรู้</h2><p>สร้างพื้นที่สำหรับผู้สนใจ นักวิจัย บุคลากรทางการศึกษา และประชาชน ได้ใช้ข้อมูลเป็นฐานในการสนทนาและเรียนรู้ร่วมกัน</p></article>
      <article class="narrative-card"><span class="narrative-card__index">03</span><h2>ประโยชน์สาธารณะ</h2><p>สนับสนุนการเข้าถึงข้อมูลที่เข้าใจง่าย ตรวจสอบที่มาได้ และนำไปต่อยอดเพื่อประโยชน์ต่อการศึกษาของจังหวัดพระนครศรีอยุธยา</p></article>
    </div>

    <Notice tone="info" title="สถานะของเว็บไซต์"><p>เว็บไซต์นี้เป็นโครงการที่จัดทำโดยผู้วิจัยอิสระ ไม่ใช่เว็บไซต์ทางการของสำนักงานสถิติจังหวัดพระนครศรีอยุธยาหรือสำนักงานสถิติแห่งชาติ การระบุชื่อหน่วยงานมีวัตถุประสงค์เพื่อแสดงแหล่งที่มาของข้อมูลเท่านั้น</p></Notice>

    <SectionCard title="แหล่งข้อมูลอ้างอิงหลัก" description="เอกสารต้นทางที่ใช้ประกอบการจัดทำตัวชี้วัด ตาราง และกราฟในเว็บไซต์">
      <div class="reference-block">
        <p class="reference-block__citation">สำนักงานสถิติจังหวัดพระนครศรีอยุธยา. (2568). <cite>รายงานสถิติจังหวัดพระนครศรีอยุธยา พ.ศ. 2568 (Phra Nakhon Si Ayutthaya Provincial Statistical Report: 2025)</cite>. สำนักงานสถิติแห่งชาติ กระทรวงดิจิทัลเพื่อเศรษฐกิจและสังคม.</p>
        <dl>
          <div><dt>หน่วยงานเจ้าของเรื่อง</dt><dd>สำนักงานสถิติจังหวัดพระนครศรีอยุธยา</dd></div>
          <div><dt>หน่วยงานต้นสังกัด</dt><dd>สำนักงานสถิติแห่งชาติ กระทรวงดิจิทัลเพื่อเศรษฐกิจและสังคม</dd></div>
          <div><dt>ปีเผยแพร่</dt><dd>พ.ศ. 2568 (ค.ศ. 2025)</dd></div>
          <div><dt>เลขมาตรฐานสากล</dt><dd>ISSN 1905-8314</dd></div>
        </dl>
        <p class="reference-block__note">เว็บไซต์ใช้ข้อมูลด้านการศึกษาจากตารางในบทที่ 3 และตารางแนวโน้ม 7.4 โดยระบุตารางต้นทางและรอบข้อมูลไว้ในแต่ละหน้า การใช้ข้อมูลเพื่ออ้างอิงทางวิชาการควรตรวจสอบกับรายงานฉบับต้นฉบับร่วมด้วย</p>
      </div>
    </SectionCard>

    <SectionCard title="ผู้ใช้งานที่เว็บไซต์ออกแบบมาเพื่อรองรับ" description="ข้อมูลเดียวกันสามารถสนับสนุนการเรียนรู้และการตัดสินใจในหลายระดับ">
      <ul class="plain-list">
        <li>ผู้บริหารและนักวางแผน ใช้ติดตามภาพรวมและความแตกต่างเชิงพื้นที่</li>
        <li>สถานศึกษาและครู ใช้เปรียบเทียบโครงสร้างผู้เรียนกับทรัพยากร</li>
        <li>นักวิจัยและสื่อ ใช้ตรวจสอบแหล่งที่มาและนำข้อมูลไปวิเคราะห์ต่อ</li>
        <li>ประชาชน ผู้ปกครอง และผู้สนใจ ใช้ทำความเข้าใจระบบการศึกษาของจังหวัด</li>
      </ul>
    </SectionCard>

    <div class="navigation-grid">
      <NavigationCard href="/" title="กลับสู่ภาพรวม" description="ดูตัวชี้วัดหลักและประเด็นสำคัญของจังหวัด" icon="trend" />
      <NavigationCard href="/methodology" title="อ่านวิธีการ" description="ตรวจสอบนิยาม การคำนวณ และข้อจำกัดของข้อมูล" icon="database" />
      <NavigationCard href="/data" title="ดูบัญชีข้อมูล" description="สำรวจขอบเขต รอบเวลา และสถานะชุดข้อมูล" icon="database" />
    </div>
  </div>
</DashboardLayout>

<style>
  .creator-profile {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--space-6);
  }

  .creator-profile__mark {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border: 1px solid #cbdce9;
    border-radius: var(--radius-lg);
    background: linear-gradient(145deg, var(--color-blue-100), #fff);
    color: var(--color-navy-900);
    font-size: var(--text-xl);
    font-weight: 800;
  }

  .creator-profile__role {
    margin: 0 0 var(--space-1);
    color: var(--color-gold-600);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .creator-profile h3 {
    margin: 0;
    color: var(--color-navy-950);
    font-size: var(--text-xl);
  }

  .creator-profile__content > p:not(.creator-profile__role) {
    max-width: 52rem;
    margin: var(--space-3) 0 0;
    color: var(--color-slate-600);
    font-size: var(--text-sm);
  }

  address {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    font-style: normal;
  }

  address span {
    color: var(--color-slate-500);
    font-weight: 650;
  }

  address a {
    color: var(--color-blue-600);
    font-weight: 700;
    overflow-wrap: anywhere;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2rem;
  }

  .reference-block__citation {
    padding: var(--space-5);
    margin: 0;
    border-left: 3px solid var(--color-gold-500);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background: var(--color-slate-50);
    color: var(--color-navy-900);
    font-size: var(--text-sm);
    line-height: 1.75;
  }

  .reference-block dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin: var(--space-5) 0 0;
  }

  .reference-block dl > div {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .reference-block dt {
    color: var(--color-slate-500);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .reference-block dd {
    margin: var(--space-1) 0 0;
    color: var(--color-navy-900);
    font-size: var(--text-sm);
    font-weight: 650;
  }

  .reference-block__note {
    margin: var(--space-5) 0 0;
    color: var(--color-slate-600);
    font-size: var(--text-sm);
  }

  @media (max-width: 640px) {
    .creator-profile {
      grid-template-columns: minmax(0, 1fr);
    }

    address {
      align-items: flex-start;
      flex-direction: column;
    }

    .reference-block dl {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
