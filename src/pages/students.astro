---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro';
import PageHeader from '../components/dashboard/PageHeader.astro';
import KpiCard from '../components/data-display/KpiCard.astro';
import ChartPanel from '../components/dashboard/ChartPanel.astro';
import SectionCard from '../components/dashboard/SectionCard.astro';
import DataTable from '../components/data-display/DataTable.astro';
import SourceNote from '../components/data-display/SourceNote.astro';
import EChart from '../components/charts/EChart';
import { femaleSeriesColor, groupedBarOption, lineOption } from '../lib/chart-options';
import { academicPeriod, formatNumber, sourceLabel, studentGrades, studentLevels, studentTrend } from '../data/fixtures';

const totalMale = studentLevels.reduce((sum, item) => sum + item.male, 0);
const totalFemale = studentLevels.reduce((sum, item) => sum + item.female, 0);
const columns = [{ key: 'grade', label: 'ระดับชั้น' }, { key: 'male', label: 'ชาย', align: 'right' as const }, { key: 'female', label: 'หญิง', align: 'right' as const }, { key: 'total', label: 'รวม', align: 'right' as const }];
const rows = studentGrades.map((item) => ({ grade: item.label, male: formatNumber(item.male), female: formatNumber(item.female), total: formatNumber(item.total) }));
---

<DashboardLayout title="นักเรียน · ศูนย์ข้อมูลการศึกษาอยุธยา" activePath="/students">
  <Breadcrumbs items={[{ label: 'ศูนย์ข้อมูล', href: '/' }, { label: 'นักเรียน' }]} />
  <div class="page-stack">
    <PageHeader eyebrow="Learner profile" title="นักเรียน" description="ติดตามจำนวน โครงสร้างตามระดับชั้นและเพศ รวมถึงแนวโน้มระยะห้าปี" period={academicPeriod} status="ข้อมูลจากรายงานทางการ" />
    <section aria-label="ตัวชี้วัดนักเรียน" class="kpi-grid">
      <KpiCard label="นักเรียนทั้งหมด" value="115,123" unit="คน" detail="ทุกสังกัด" icon="students" featured />
      <KpiCard label="นักเรียนชาย" value={formatNumber(totalMale)} unit="คน" detail="50.4% ของทั้งหมด" icon="students" />
      <KpiCard label="นักเรียนหญิง" value={formatNumber(totalFemale)} unit="คน" detail="49.6% ของทั้งหมด" icon="students" />
      <KpiCard label="เปลี่ยนแปลงจากปีก่อน" value="−4.2%" detail="ค่าคำนวณจาก 120,206 คนในปี 2566" trend="ลดลง 5,083 คน" trendDirection="down" icon="trend" />
    </section>
    <div class="content-grid">
      <ChartPanel title="โครงสร้างนักเรียนตามระดับและเพศ" description="เปรียบเทียบจำนวนนักเรียนชายและหญิง" height={360}>
        <EChart client:visible option={groupedBarOption(studentLevels.map((item) => item.label), [{ name: 'ชาย', data: studentLevels.map((item) => item.male) }, { name: 'หญิง', data: studentLevels.map((item) => item.female), color: femaleSeriesColor }])} label="กราฟจำนวนนักเรียนชายหญิงแยกตามระดับการศึกษา" />
      </ChartPanel>
      <ChartPanel title="แนวโน้มนักเรียน 5 ปี" description="ปีการศึกษา 2563–2567" height={360}>
        <EChart client:visible option={lineOption(studentTrend.map((item) => item.year), studentTrend.map((item) => item.total), 'นักเรียน')} label="กราฟแนวโน้มจำนวนนักเรียนห้าปี" />
      </ChartPanel>
    </div>
    <SectionCard title="นักเรียนจำแนกตามระดับชั้น" description="ตั้งแต่อนุบาลถึงมัธยมศึกษาปีที่ 6">
      <DataTable caption="จำนวนนักเรียนแยกตามชั้นเรียนและเพศ" columns={columns} rows={rows} compact />
    </SectionCard>
    <SourceNote source={sourceLabel} period={academicPeriod} table="ตาราง 3.3–3.5 และ 7.4" note="ผลรวมชายและหญิงสอดคล้องกับยอดรวมจังหวัดในตารางต้นทาง" />
  </div>
</DashboardLayout>
